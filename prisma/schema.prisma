generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Story {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  bookSlug  String
  domain    String
  indexUrl  String
  tuaid     String?
  priority  Int       @default(1)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  chapters  Chapter[]
}

model Chapter {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  summary   String?
  sourceUrl String   @unique
  audioPath String?
  createdAt DateTime @default(now())
  storyId   Int?
  story     Story?   @relation(fields: [storyId], references: [id])
}
