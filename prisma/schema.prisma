generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Chapter {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  summary   String?
  sourceUrl String   @unique
  createdAt DateTime @default(now())
}
